# Copy to env.sh (gitignored), fill in, then: source env.sh
export FREYA_API_KEY=fak_your_key_here                       # Freya workspace -> API keys
export FREYA_API_URL=https://staging-app.freyavoice.ai
export FREYA_BANK_TEAM_KEY=pick-any-secret-of-16-or-more-characters   # stable; same one every time
# Builder model access: the Claude Agent SDK uses your Claude Code login by default (`claude auth login`;
# check with `claude auth status`). Only set one of these if you have no interactive login:
# export CLAUDE_CODE_OAUTH_TOKEN=...                         # `claude setup-token` (Pro/Max/Team/Enterprise)
# export ANTHROPIC_API_KEY=sk-ant-...                        # optional, billed per token; overrides the login if set
export BUILDER_MODEL=claude-opus-5-5
