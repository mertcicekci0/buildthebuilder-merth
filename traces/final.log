"http\": 200,\n              \"response\": {\n                \"data\": {\n                  \"statementDate\": \"23.11.2026\",\n                  \"statementDueDate\": \"03.12.2026\",\n                  \"statementDay\": 23,\n                  \"responseCode\": 0,\n                  \"responseMessage\": \"Success\"\n                },\n                \"result\": {\n                  \"guid\": \"f0e1d2c3b4a5968778695a4b3c2d0007\",\n                  \"returnCode\": \"1\",\n                  \"messageText\": \"Success\",\n                  \"code\": \"1\",\n                  \"message\": \"Success\",\n                  \"type\": null,\n                  \"details\": {\n                    \"guid\": \"f0e1d2c3b4a5968778695a4b3c2d0007\",\n                    \"rootCause\": null,\n                    \"errorOrigin\": null\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"statement.week.change\": {\n          \"540000******1234\": {\n            \"2\": {\n              \"http\": 200,\n              \"response\": {\n                \"data\": {\n                  \"responseCode\": 0,\n                  \"responseMessage\": \"00\",\n                  \"statementWeek\": \"2\",\n                  \"statementDay\": \"9\",\n                  \"exitState\": \"OK\"\n                },\n                \"result\": {\n                  \"guid\": \"f0e1d2c3b4a5968778695a4b3c2d0008\",\n                  \"returnCode\": \"1\",\n                  \"messageText\": \"Success\",\n                  \"code\": \"1\",\n                  \"message\": \"Success\",\n                  \"type\": null,\n                  \"details\": {\n                    \"guid\": \"f0e1d2c3b4a5968778695a4b3c2d0008\",\n                    \"rootCause\": null,\n                    \"errorOrigin\": null\n                  }\n                }\n              }\n            },\n            \"3\": {\n              \"http\": 200,\n              \"response\": {\